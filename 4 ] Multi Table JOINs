# DISPLAY CUSTOMERS TABLE

SELECT * FROM Customers;

# DISPLAY ORDERS TABLE

SELECT * FROM Orders;

# INNER JOIN
# RETRIEVE ONLY CUSTOMERS WHO HAVE PLACED ORDERS

SELECT Customers.CustomerID,
Customers.CustomerName,
Orders.OrderID,
Orders.ProductName,
Orders.Amount
FROM Customers
INNER JOIN Orders
ON Customers.CustomerID = Orders.CustomerID;

# LEFT JOIN
# RETRIEVE ALL CUSTOMERS INCLUDING THOSE WITHOUT ORDERS

SELECT Customers.CustomerID,
Customers.CustomerName,
Orders.OrderID,
Orders.ProductName,
Orders.Amount
FROM Customers
LEFT JOIN Orders
ON Customers.CustomerID = Orders.CustomerID;

# RIGHT JOIN
# RETRIEVE ALL ORDERS INCLUDING ORDERS WITHOUT MATCHING CUSTOMERS

SELECT Customers.CustomerID,
Customers.CustomerName,
Orders.OrderID,
Orders.ProductName,
Orders.Amount
FROM Customers
RIGHT JOIN Orders
ON Customers.CustomerID = Orders.CustomerID;

# FULL OUTER JOIN
# RETRIEVE ALL CUSTOMERS AND ALL ORDERS INCLUDING NON-MATCHING RECORDS

SELECT Customers.CustomerID,
Customers.CustomerName,
Orders.OrderID,
Orders.ProductName,
Orders.Amount
FROM Customers
LEFT JOIN Orders
ON Customers.CustomerID = Orders.CustomerID

UNION

SELECT Customers.CustomerID,
Customers.CustomerName,
Orders.OrderID,
Orders.ProductName,
Orders.Amount
FROM Customers
RIGHT JOIN Orders
ON Customers.CustomerID = Orders.CustomerID;
