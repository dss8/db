# CREATE DATABASE

CREATE DATABASE SalesDB;
USE SalesDB;

# CREATE SALES TABLE

CREATE TABLE Sales (
    SaleID INT AUTO_INCREMENT PRIMARY KEY,
    ProductName VARCHAR(100),
    Quantity INT,
    Price DECIMAL(10,2),
    TotalAmount DECIMAL(10,2)
);

# DISPLAY SALES TABLE STRUCTURE

DESC Sales;

# STORED PROCEDURE TO INSERT DATA INTO SALES TABLE

DELIMITER //

CREATE PROCEDURE AddSale(
    IN p_ProductName VARCHAR(100),
    IN p_Quantity INT,
    IN p_Price DECIMAL(10,2)
)

BEGIN

    INSERT INTO Sales(ProductName, Quantity, Price, TotalAmount)
    VALUES(
        p_ProductName,
        p_Quantity,
        p_Price,
        p_Quantity * p_Price
    );

END //

DELIMITER ;

# CALL STORED PROCEDURE

CALL AddSale('Laptop',2,55000);

CALL AddSale('Mobile',3,20000);

CALL AddSale('Keyboard',5,1000);

# DISPLAY SALES TABLE DATA

SELECT * FROM Sales;

# FUNCTION TO CALCULATE TOTAL SALES

DELIMITER //

CREATE FUNCTION GetTotalSales()
RETURNS DECIMAL(10,2)

DETERMINISTIC

BEGIN

    DECLARE TotalSales DECIMAL(10,2);

    SELECT SUM(TotalAmount)
    INTO TotalSales
    FROM Sales;

    RETURN TotalSales;

END //

DELIMITER ;

# CALL FUNCTION TO DISPLAY TOTAL SALES

SELECT GetTotalSales() AS Total_Sales;
