CREATE VIEW student_view AS
SELECT StudentID, Name, Email, Age
FROM Student;

CREATE VIEW student_course_view AS
SELECT
s.StudentID,
s.Name,
c.CourseName,
e.EnrollmentDate
FROM Student s
INNER JOIN Enrollment e
ON s.StudentID = e.StudentID
INNER JOIN Course c
ON e.CourseID = c.CourseID;

