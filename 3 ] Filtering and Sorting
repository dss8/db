# FILTERING DATA USING WHERE

SELECT * FROM Student
WHERE Age > 21;

# FILTERING BY INSTRUCTOR

SELECT Course.CourseName, Instructor.Name
FROM Course
INNER JOIN Instructor
ON Course.InstructorID = Instructor.InstructorID
WHERE Instructor.Name = 'Dr Sharma';

# SORTING DATA USING ORDER BY ALPHABETICALLY

SELECT * FROM Student
ORDER BY Name ASC;

# SORTING COURSES BY CREDITS

SELECT * FROM Course
ORDER BY Credits DESC;

# AGGREGATION USING GROUP BY

SELECT CourseID, COUNT(StudentID) AS TotalStudents
FROM Enrollment
GROUP BY CourseID;

# AVERAGE AGE OF STUDENTS

SELECT AVG(Age) AS AverageAge
FROM Student;

# NESTED SUBQUERY - STUDENTS ENROLLED IN COURSE 1

SELECT Name
FROM Student
WHERE StudentID IN (
    SELECT StudentID
    FROM Enrollment
    WHERE CourseID = 1
);

# NESTED SUBQUERY - COURSE WITH MAXIMUM CREDITS

SELECT CourseName
FROM Course
WHERE Credits = (
    SELECT MAX(Credits)
    FROM Course
);

# NESTED SUBQUERY - STUDENTS ABOVE AVERAGE AGE

SELECT Name
FROM Student
WHERE Age > (
    SELECT AVG(Age)
    FROM Student
);
