# CREATE DATABASE

CREATE DATABASE EmployeeDB;
USE EmployeeDB;

# CREATE EMPLOYEES TABLE

CREATE TABLE Employees (
    EmpID INT AUTO_INCREMENT PRIMARY KEY,
    EmpName VARCHAR(100),
    Department VARCHAR(100),
    Salary DECIMAL(10,2)
);

